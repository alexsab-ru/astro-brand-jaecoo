---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button/Button.astro';
import settings from '@/data/site/settings.json';
const { site_name, brand, legal_city, legal_city_where, legal_entity, legal_inn } = settings;
---

<PageLayout 
	h1="Реквизиты"
	title={`${site_name} ${legal_city} — Реквизиты`} 
	description={`Официальный дилер ${brand} в ${legal_city_where}. На сайте Вы можете подобрать и купить автомобиль JAECOO.`}
	breadcrumb={[{name:"Реквизиты",href:""}]}
>
	<div class="space-y-3">                
		<p><strong>Юридическое название</strong> {legal_entity}</p>
		<p><strong>Полное название</strong> Общество с ограниченной ответственностью {legal_entity}</p>
		<p><strong>ФИО руководителя</strong> Курылин Александр Иванович</p>
		<p><strong>Должность руководителя</strong> директор</p>
		<p><strong>Действующий на основании (устава, доверенности)</strong> Устава</p>
		<p><strong>Юридический адрес</strong> 445043, Самарская обл., Тольятти г, Воскресенская ул., д. 16, строение 1</p>
		<p><strong>Почтовый адрес</strong> 432071, РФ, Городая обл., г. Город, ул. Урицкого, дом 45, офис 1</p>
		<p><strong>ФИО адресата (кто получит письмо)</strong> Прусакова Наталья Александровна</p>
		<p><strong>ОГРН</strong> 1107327005312</p>
		<p><strong>ИНН</strong> {legal_inn}</p>
		<p><strong>КПП</strong> 632101001</p>
		<p><strong>Банк</strong> ВТБ (ПАО) г. Москва</p>
		<p><strong>БИК банка</strong> 44525411</p>
		<p><strong>Расчетный счет</strong> 40702810511240000000</p>
		<p><strong>Корреспондетский счет</strong> 30101810145250000411</p>
	</div>
</PageLayout>