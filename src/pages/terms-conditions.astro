---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button/Button.astro';
import settings from '@/data/settings.json';
const { site_name, brand, legal_city, legal_city_where, legal_entity } = settings;
---

<PageLayout 
	h1="Правовая информация"
	title={`${site_name} ${legal_city} — Правовая информация`} 
	description={`Официальный дилер ${brand} в ${legal_city_where}. На сайте Вы можете подобрать и купить автомобиль JAECOO.`}
	breadcrumb={[{name:"Правовая информация",href:""}]}
>
	<div class="space-y-3">
		<p><a href="/privacy-policy/">{`Политика ${legal_entity} в отношении обработки персональных данных`}</a></p>
		<p><a href="/cookie-policy/">Правила использования cookie</a></p>
		<p><a href="/requisites/">{`Реквизиты ${legal_entity}`}</a></p>
	</div>
</PageLayout>